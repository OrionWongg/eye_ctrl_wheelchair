Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 40
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (1 m)
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 60
      Color: 85; 85; 90
    - Class: rviz_default_plugins/Map
      Name: Office planning map
      Enabled: true
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /wheelchair/planning_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local costmap (inflation)
      Enabled: true
      Alpha: 0.65
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /wheelchair/local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Laser (cyan)
      Enabled: true
      Topic:
        Value: /wheelchair/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Position Transformer: XYZ
      Decay Time: 0.2
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Polygon
      Name: Nav2 footprint
      Enabled: true
      Topic:
        Value: /wheelchair/local_costmap/published_footprint
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 80; 255; 80
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Last planned path (green; check age in text)
      Enabled: true
      Topic:
        Value: /wheelchair/debug/local_plan
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 30; 255; 80
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.04
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.08
    - Class: rviz_default_plugins/Path
      Name: Actual trajectory (white)
      Enabled: true
      Topic:
        Value: /wheelchair/debug/executed_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 255; 255; 255
      Alpha: 0.8
      Line Style: Billboards
      Line Width: 0.025
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Name: Diagnostics (body, margin, sweep, goal, reason)
      Enabled: true
      Topic:
        Value: /wheelchair/debug/markers
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: Coordinate frames (optional)
      Enabled: false
      Show Names: true
      Show Axes: true
      Show Arrows: false
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Follow wheelchair
      Target Frame: base_link
      Scale: 85
      Angle: 0
      X: 0
      Y: 0
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Office overview
        Target Frame: odom
        Scale: 20
        Angle: 0
        X: 7
        Y: 0
Window Geometry:
  Width: 1400
  Height: 900
  X: 50
  Y: 50
