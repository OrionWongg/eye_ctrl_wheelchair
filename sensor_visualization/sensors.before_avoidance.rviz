Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /PointCloud21
    Splitter Ratio: 0.5
  Tree Height: 796
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Nav Goal1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
