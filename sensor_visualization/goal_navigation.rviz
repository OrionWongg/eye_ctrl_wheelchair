Panels:
- Class: rviz_common/Displays
  Help Height: 78
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /Status1
    - /PointCloud21
    Splitter Ratio: 0.5
  Tree Height: 796
- Class: rviz_common/Selection
  Name: Selection
- Class: rviz_common/Tool Properties
  Expanded:
  - /2D Nav Goal1
  - /Publish Point1
  Name: Tool Properties
  Splitter Ratio: 0.5886790156364441
- Class: rviz_common/Views
  Expanded:
  - /Current View1
  Name: Views
  Splitter Ratio: 0.5
Visualization Manager:
  Class: ''
  Displays:
  - Alpha: 0.5
    Cell Size: 1
    Class: rviz_default_plugins/Grid
    Color: 160; 160; 164
    Enabled: true
    Line Style:
      Line Width: 0.029999999329447746
      Value: Lines
    Name: Grid
    Normal Cell Count: 0
    Offset:
      X: 0
      Y: 0
      Z: 0
    Plane: XY
    Plane Cell Count: 10
    Reference Frame: <Fixed Frame>
    Value: true
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 80; 200; 255
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 150
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: MID360 right 201
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.009999999776482582
    Style: Flat Squares
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /mid360_201/points_filtered
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 255; 100; 80
    Color Transformer: FlatColor
    Decay Time: 0.0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 150
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: MID360 left 202
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.009999999776482582
    Style: Flat Squares
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /mid360_202/points_filtered
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Alpha: 1
    Autocompute Intensity Bounds: true
    Autocompute Value Bounds:
      Max Value: 10
      Min Value: -10
      Value: true
    Axis: Z
    Channel Name: intensity
    Class: rviz_default_plugins/PointCloud2
    Color: 100; 255; 100
    Color Transformer: RGB8
    Decay Time: 0.0
    Enabled: false
    Invert Rainbow: false
    Max Color: 255; 255; 255
    Max Intensity: 150
    Min Color: 0; 0; 0
    Min Intensity: 0
    Name: Odin1 RGB
    Position Transformer: XYZ
    Queue Size: 2
    Selectable: true
    Size (Pixels): 2
    Size (m): 0.009999999776482582
    Style: Flat Squares
    Topic:
      Depth: 1
      Durability Policy: Volatile
      History Policy: Keep Last
      Reliability Policy: Best Effort
      Value: /odin1/cloud_render
    Unreliable: false
    Use Fixed Frame: true
    Use rainbow: true
    Value: false
  - Class: rviz_default_plugins/Axes
    Name: Wheelchair axes
    Enabled: true
    Reference Frame: base_link
    Length: 0.5
    Radius: 0.02
    Value: true
  - Class: rviz_common/Group
    Name: Wheelchair avoidance
    Enabled: true
    Displays:
    - Class: rviz_default_plugins/Map
      Name: Observed occupancy (unknown = gray)
      Enabled: true
      Alpha: 0.55
      Color Scheme: map
      Draw Behind: true
      Topic:
        Value: /wheelchair/planning_map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Map
      Name: Local costmap (inflation)
      Enabled: true
      Alpha: 0.65
      Color Scheme: costmap
      Draw Behind: false
      Topic:
        Value: /wheelchair/local_costmap/costmap
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/LaserScan
      Name: Laser (cyan)
      Enabled: true
      Topic:
        Value: /wheelchair/scan
        Depth: 5
        Durability Policy: Volatile
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Size (m): 0.025
      Color Transformer: FlatColor
      Color: 0; 255; 255
      Position Transformer: XYZ
      Decay Time: 0.2
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Polygon
      Name: Nav2 footprint
      Enabled: true
      Topic:
        Value: /wheelchair/local_costmap/published_footprint
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
      Color: 80; 255; 80
      Alpha: 1
    - Class: rviz_default_plugins/Path
      Name: Last planned path (green; check age in text)
      Enabled: true
      Topic:
        Value: /wheelchair/debug/local_plan
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 30; 255; 80
      Alpha: 1
      Line Style: Billboards
      Line Width: 0.04
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.08
    - Class: rviz_default_plugins/Path
      Name: Actual trajectory (white)
      Enabled: true
      Topic:
        Value: /wheelchair/debug/executed_path
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 255; 255; 255
      Alpha: 0.8
      Line Style: Billboards
      Line Width: 0.025
      Buffer Length: 1
      Offset:
        X: 0
        Y: 0
        Z: 0.1
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety margins, predicted motion and stop reason
      Enabled: true
      Topic:
        Value: /wheelchair/debug/markers
        Depth: 1
        Durability Policy: Volatile
        Reliability Policy: Reliable
  - Class: rviz_default_plugins/MarkerArray
    Name: Live data status
    Enabled: true
    Topic:
      Value: /wheelchair/display/stream_status
      Depth: 1
      Durability Policy: Volatile
      Reliability Policy: Reliable
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 15
  Name: root
  Tools:
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
    Line color: 128; 128; 0
  - Class: rviz_default_plugins/SetInitialPose
    Topic: /initialpose
  - Class: rviz_default_plugins/SetGoal
    Topic: /goal_pose
  - Class: rviz_default_plugins/PublishPoint
    Single click: true
    Topic: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Follow wheelchair
      Target Frame: base_link
      Scale: 85
      Angle: 0
      X: 0
      Y: 0
    Saved: []
Window Geometry:
  Width: 1400
  Height: 900
  X: 40
  Y: 40
