Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Background Color: 35; 35; 35
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
    - Class: rviz_default_plugins/MarkerArray
      Name: Safety decision
      Enabled: true
      Marker Topic:
        Value: /wheelchair/safety_markers
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top down
      Scale: 80
      Target Frame: odom
